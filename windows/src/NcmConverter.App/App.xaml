<Application
    x:Class="NcmConverter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandPinkBrush" Color="#FB7299" />
                    <SolidColorBrush x:Key="BrandPinkHoverBrush" Color="#E45C86" />
                    <SolidColorBrush x:Key="BrandPinkPressedBrush" Color="#C94E74" />
                    <SolidColorBrush x:Key="BrandBlueBrush" Color="#00A1D6" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#FFE8EF" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6FA" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandPinkBrush" Color="#FF85A9" />
                    <SolidColorBrush x:Key="BrandPinkHoverBrush" Color="#FF9EB8" />
                    <SolidColorBrush x:Key="BrandPinkPressedBrush" Color="#FFB3C8" />
                    <SolidColorBrush x:Key="BrandBlueBrush" Color="#33B5E5" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#3A2732" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#17181C" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#212228" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="BrandButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource BrandPinkBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,10" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

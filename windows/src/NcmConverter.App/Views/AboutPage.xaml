<Page
    x:Class="NcmConverter.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            Margin="20,16,20,24"
            Spacing="12">
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="64"
                        Height="64"
                        Background="{ThemeResource BrandPinkBrush}"
                        CornerRadius="16">
                        <FontIcon
                            FontSize="32"
                            Foreground="White"
                            Glyph="&#xE8D6;" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="NCM 转 FLAC" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="版本 0.1.0 · 完全离线的 NCM 音频转换工具" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="把 NCM 还原为原始 FLAC/MP3，保留歌曲信息与封面。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="功能" />
                    <TextBlock Text="· 仅解密容器，不做二次编码：FLAC 源输出 .flac，MP3 源输出 .mp3" TextWrapping="Wrap" />
                    <TextBlock Text="· 批量队列、并发转换、进度、取消、失败重试" TextWrapping="Wrap" />
                    <TextBlock Text="· 自动写入歌名、歌手、专辑与内嵌封面" TextWrapping="Wrap" />
                    <TextBlock Text="· 转换历史、深浅主题、设置持久化" TextWrapping="Wrap" />
                    <TextBlock Text="· 零网络请求，不上传任何文件" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="合规声明" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="本工具仅用于用户对自己合法获得的个人音频进行本地格式还原与备份。请勿用于传播、分发或任何侵犯版权的行为。与网易云音乐及其关联公司无任何关系，未获其授权或背书。因使用本工具产生的任何法律责任由使用者自行承担。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="开源与许可" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="MIT License · 第三方组件：TagLib#、CommunityToolkit.Mvvm、Windows App SDK"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Click="OpenRepository_Click"
                        Content="github.com/Alvin070911/ncm-converter" />
                </StackPanel>
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="源码与问题反馈请访问 GitHub 仓库" />
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="NcmConverter.App.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NcmConverter.App.Models"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="20,16,20,0"
            AllowDrop="True"
            DragOver="DropZone_DragOver"
            Drop="DropZone_Drop"
            Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource BrandPinkBrush}"
                            Glyph="&#xE8D6;" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="拖放 NCM 文件或文件夹到这里" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="完全离线 · 保留原始 FLAC/MP3 · 自动写入歌曲信息与封面" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="SelectFiles_Click"
                        Content="选择文件"
                        Style="{StaticResource BrandButtonStyle}" />
                    <Button Click="SelectFolder_Click" Content="选择文件夹" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,4,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    x:Name="SummaryText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="队列为空" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="16"
                    Height="16"
                    Foreground="{ThemeResource BrandPinkBrush}"
                    IsActive="False" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="StartButton"
                    Click="Start_Click"
                    Content="开始转换"
                    IsEnabled="False"
                    Style="{StaticResource BrandButtonStyle}" />
                <Button
                    x:Name="CancelButton"
                    Click="Cancel_Click"
                    Content="取消"
                    IsEnabled="False" />
                <Button Click="Retry_Click" Content="重试失败" />
                <Button Click="Clear_Click" Content="清理已完成" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="2"
            Margin="20,0"
            IsOpen="False"
            IsClosable="True" />

        <Grid Grid.Row="3" Margin="20,0">
            <ListView
                x:Name="QueueList"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConversionItem">
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top"
                                Background="{ThemeResource BrandSoftBrush}"
                                CornerRadius="8">
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource BrandPinkBrush}"
                                    Glyph="&#xE8D6;" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Subtitle, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <ProgressBar
                                    Height="4"
                                    Margin="0,4,0,0"
                                    Foreground="{ThemeResource BrandPinkBrush}"
                                    Maximum="100"
                                    Value="{x:Bind Progress, Mode=OneWay}"
                                    Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ErrorText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Spacing="4">
                                <Border
                                    Padding="8,2"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource BrandSoftBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource BrandPinkBrush}"
                                        Text="{x:Bind FormatBadge, Mode=OneWay}" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="3"
                                VerticalAlignment="Top"
                                Spacing="4">
                                <Button
                                    Click="RetryItem_Click"
                                    Content="重试"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                                <Button
                                    Click="RemoveItem_Click"
                                    Content="移除"
                                    Tag="{x:Bind}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="36"
                    Foreground="{ThemeResource BrandPinkBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="把 NCM 文件拖进来，或点击选择文件" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="支持批量导入与文件夹递归扫描" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="4"
            Margin="20,0,20,16"
            Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="输出位置" />
                    <TextBlock
                        x:Name="OutputText"
                        FontWeight="SemiBold"
                        Text="与源文件同目录"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Click="ChangeOutput_Click"
                    Content="更改" />
                <Button
                    x:Name="OpenOutputButton"
                    Grid.Column="2"
                    Click="OpenOutput_Click"
                    Content="打开目录" />
            </Grid>
        </Border>
    </Grid>
</Page>
